# ─── Python tooling ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.venv/
venv/

# ─── ORFS work dir (EDA_RL_WORK) — all per-variant staging + build output ──────
eda_rl_runs/
# also catch a work dir created at the repo root by older defaults
runs/

# ─── Regenerable model snapshots — rebuilt by eda-rl fit-surrogate ────────────
*.joblib

# ─── Generated reports / dashboards (rebuilt from results/*.jsonl) ─────────────
eda_rl/reports/
reports/
*.optuna-journal

# ─── Raw per-run campaign logs dumped at root (curated copies live in campaigns/)
funnel_campaign_*.jsonl
*_run[0-9]*.jsonl
*_trial.jsonl

# ─── Per-fidelity traces written alongside every campaign log ─────────────────
# FunnelEnv logs one row per (config, fidelity, obs) to
# campaigns/<design>/<platform>/funnel_<campaign_id>.jsonl (older runs named
# these campaign_<ts>.jsonl).  They are large — 5.2 MB and 3.0 MB copies were
# tracked despite AGENTS.md already declaring them ignored — and are raw
# artifacts, not curated evidence.  Only the per-episode
# results_funnel_campaigns.jsonl belongs in git.
eda_rl/campaigns/**/funnel_*.jsonl
eda_rl/campaigns/**/campaign_[0-9]*.jsonl
eda_rl/campaigns/**/run[0-9]*.jsonl

# ─── Generated output of `eda-rl collect` (GDS + comparison page) ──────────────
best_configs/
